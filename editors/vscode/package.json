{
  "name": "sundgren",
  "displayName": "sundgren",
  "description": "Multi-language code review tool",
  "version": "2.0.0",
  "publisher": "axean",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/axean/sundgren",
    "directory": "editors/vscode"
  },
  "homepage": "https://axean.github.io/sundgren/",
  "bugs": "https://github.com/axean/sundgren/issues",
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "preview": true,
  "keywords": [
    "git",
    "branches",
    "compare",
    "rebase",
    "cherry-pick",
    "merge request",
    "history",
    "graph",
    "log"
  ],
  "engines": {
    "node": ">=22",
    "vscode": "^1.125.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "sundgren.showHistory",
        "title": "sundgren: Show History",
        "icon": "$(git-commit)"
      },
      {
        "command": "sundgren.showContainment",
        "title": "sundgren: Show Containment",
        "icon": "$(git-compare)"
      },
      {
        "command": "sundgren.inspect",
        "title": "sundgren: Inspect Branch"
      },
      {
        "command": "sundgren.showOutline",
        "title": "sundgren: Show Outline",
        "icon": "$(list-tree)"
      },
      {
        "command": "sundgren.menu",
        "title": "sundgren: Menu"
      }
    ],
    "icons": {
      "sundgren-tree": {
        "description": "The sundgren tree, for the status bar.",
        "default": {
          "fontPath": "sundgren-icons.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sundgren.inspect",
          "when": "false"
        },
        {
          "command": "sundgren.menu",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "sundgren.showHistory",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "sundgren.showHistory",
          "when": "scmProvider == git",
          "group": "sundgren@1"
        },
        {
          "command": "sundgren.showContainment",
          "when": "scmProvider == git",
          "group": "sundgren@2"
        }
      ]
    },
    "configuration": {
      "title": "sundgren",
      "properties": {
        "sundgren.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to a `sundgren` binary to use instead of the bundled one."
        },
        "sundgren.base": {
          "type": "string",
          "default": "",
          "markdownDescription": "The canonical branch for **Show Containment**: a branch's work is what it added since it left this one. Empty: the repository's default branch (what `origin/HEAD` points at, else `main` or `master`)."
        },
        "sundgren.protected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master"
          ],
          "markdownDescription": "Branch name patterns drawn in the protected colour in **Show History**."
        },
        "sundgren.historyPage": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "markdownDescription": "How many commits of the base **Show History** reads at first, and how many more each **Load older** adds."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile-tests": "tsc --outDir out",
    "test:unit": "npm run compile-tests && mocha --fail-zero \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile-tests && npm run build && vscode-test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "package": "vsce package",
    "test:vsix": "npm run compile-tests && node out/test/vsix/run.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
