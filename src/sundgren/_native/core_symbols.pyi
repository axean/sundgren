"""Stubs for sundgren._native.core_symbols."""

from collections.abc import Iterable
from dataclasses import Field
from pathlib import Path
from typing import Any, ClassVar

from .core_model import FileCoverage

class Span:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("name", "start", "end", "body_start")
    def __init__(self, name: str, start: int, end: int, body_start: int | None = None) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def start(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def body_start(self) -> int | None: ...
    @property
    def body_lines(self) -> range: ...
    def __hash__(self) -> int: ...

class LcovFnSymbolizer:
    def spans(self, fc: FileCoverage) -> list[Span]: ...

def resolve_spans(path: str, root: Path | None, fc: FileCoverage | None) -> list[Span] | None: ...
def spans_by_name(spans: Iterable[Span]) -> dict[str, Span]: ...
