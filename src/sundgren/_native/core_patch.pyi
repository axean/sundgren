"""Stubs for sundgren._native.core_patch."""

from collections.abc import Iterable
from dataclasses import Field
from typing import Any, ClassVar

class Hunk:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("old_start", "old_count", "new_start", "new_count", "lines")
    def __init__(
        self, old_start: int, old_count: int, new_start: int, new_count: int, lines: Iterable[str]
    ) -> None: ...
    @property
    def old_start(self) -> int: ...
    @property
    def old_count(self) -> int: ...
    @property
    def new_start(self) -> int: ...
    @property
    def new_count(self) -> int: ...
    @property
    def lines(self) -> tuple[str, ...]: ...
    def __hash__(self) -> int: ...

class FilePatch:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("old_path", "new_path", "hunks", "binary")
    def __init__(
        self,
        old_path: str | None,
        new_path: str | None,
        hunks: Iterable[Hunk],
        binary: bool = False,
    ) -> None: ...
    @property
    def old_path(self) -> str | None: ...
    @property
    def new_path(self) -> str | None: ...
    @property
    def hunks(self) -> tuple[Hunk, ...]: ...
    @property
    def binary(self) -> bool: ...
    @property
    def path(self) -> str: ...
    def __hash__(self) -> int: ...

class Patch:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("files", "warnings")
    def __init__(self, files: Iterable[FilePatch], warnings: Iterable[str] = ()) -> None: ...
    @property
    def files(self) -> tuple[FilePatch, ...]: ...
    @property
    def warnings(self) -> tuple[str, ...]: ...
    def touched_paths(self) -> tuple[str, ...]: ...
    def __hash__(self) -> int: ...

def parse_patch(text: str) -> Patch: ...
