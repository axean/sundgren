"""Stubs for sundgren._native.core_linemap."""

from collections.abc import Iterable, Mapping
from dataclasses import Field
from typing import Any, ClassVar

from .core_patch import Patch

class LineMap:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("old_path", "new_path", "old_to_new", "deleted_old", "added_new")
    def __init__(
        self,
        old_path: str | None,
        new_path: str | None,
        old_to_new: Mapping[int, int],
        deleted_old: Iterable[int],
        added_new: Iterable[int],
    ) -> None: ...
    @property
    def old_path(self) -> str | None: ...
    @property
    def new_path(self) -> str | None: ...
    @property
    def old_to_new(self) -> dict[int, int]: ...
    @property
    def deleted_old(self) -> frozenset[int]: ...
    @property
    def added_new(self) -> frozenset[int]: ...
    def to_new(self, old: int) -> int | None: ...
    def to_old(self, new: int) -> int | None: ...
    @property
    def is_identity(self) -> bool: ...

def identity(path: str) -> LineMap: ...
def build_linemaps(patch: Patch) -> dict[str, LineMap]: ...
def linemap_for(linemaps: Mapping[str, LineMap], path: str) -> LineMap: ...
