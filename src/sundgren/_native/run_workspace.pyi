"""Stubs for sundgren._native.run_workspace."""

from pathlib import Path
from types import TracebackType

class PatchApplyError(Exception):
    """git apply failed; str(exc) is git's message."""

class GitError(RuntimeError):
    """A git command other than `git apply` failed; str(exc) is git's message."""

class BadRefError(GitError):
    """The base ref doesn't name a commit."""

class Workspace:
    @property
    def repo(self) -> Path: ...
    @property
    def base_ref(self) -> str: ...
    @property
    def patch(self) -> Path: ...
    @property
    def keep(self) -> bool: ...
    @property
    def workdir(self) -> Path: ...
    @property
    def base(self) -> Path: ...
    @property
    def patched(self) -> Path: ...
    @property
    def base_sha(self) -> str: ...
    @property
    def applied_patch(self) -> str: ...
    @property
    def offset_paths(self) -> tuple[str, ...]: ...
    def __init__(
        self, repo: Path, base_ref: str, patch: Path, *, workdir: Path | None, keep: bool
    ) -> None: ...
    def __enter__(self) -> Workspace: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> None: ...

def repo_root(path: Path) -> Path: ...
def is_dirty(repo: Path) -> bool: ...
