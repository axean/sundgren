"""Stubs for sundgren._native.core_model."""

from collections.abc import Iterable, Mapping
from dataclasses import Field
from typing import Any, ClassVar, Literal

class LineStatus:
    ABSENT: ClassVar[LineStatus]
    MISS: ClassVar[LineStatus]
    HIT: ClassVar[LineStatus]
    @property
    def value(self) -> Literal["absent", "miss", "hit"]: ...
    @property
    def name(self) -> str: ...

class BranchKey:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("line", "block", "branch")
    def __init__(self, line: int, block: str, branch: str) -> None: ...
    @property
    def line(self) -> int: ...
    @property
    def block(self) -> str: ...
    @property
    def branch(self) -> str: ...
    def __hash__(self) -> int: ...
    def __lt__(self, other: BranchKey) -> bool: ...
    def __le__(self, other: BranchKey) -> bool: ...
    def __gt__(self, other: BranchKey) -> bool: ...
    def __ge__(self, other: BranchKey) -> bool: ...

class FunctionRecord:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("name", "start", "end", "hits")
    def __init__(self, name: str, start: int, end: int | None, hits: int | None) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def start(self) -> int: ...
    @property
    def end(self) -> int | None: ...
    @property
    def hits(self) -> int | None: ...
    def __hash__(self) -> int: ...

class FileCoverage:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("path", "lines", "branches", "functions", "external")
    def __init__(
        self,
        path: str,
        lines: Mapping[int, int],
        branches: Mapping[BranchKey, int | None],
        functions: Iterable[FunctionRecord],
        external: bool,
    ) -> None: ...
    @property
    def path(self) -> str: ...
    @property
    def lines(self) -> dict[int, int]: ...
    @property
    def branches(self) -> dict[BranchKey, int | None]: ...
    @property
    def functions(self) -> tuple[FunctionRecord, ...]: ...
    @property
    def external(self) -> bool: ...
    def status(self, line: int) -> LineStatus: ...

class Snapshot:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("files", "test_names")
    def __init__(self, files: Mapping[str, FileCoverage], test_names: Iterable[str]) -> None: ...
    @property
    def files(self) -> dict[str, FileCoverage]: ...
    @property
    def test_names(self) -> tuple[str, ...]: ...

class ReportWarning:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("code", "message")
    def __init__(self, code: str, message: str) -> None: ...
    @property
    def code(self) -> str: ...
    @property
    def message(self) -> str: ...
    def __hash__(self) -> int: ...

def merge_file_coverage(a: FileCoverage, b: FileCoverage) -> FileCoverage: ...
def snapshot_to_dict(snapshot: Snapshot) -> dict[str, Any]: ...
