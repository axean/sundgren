"""Stubs for sundgren._native.run_selectors."""

from dataclasses import Field
from pathlib import Path
from typing import Any, ClassVar, Protocol

from sundgren.core.patch import Patch

class Selection:
    __dataclass_fields__: ClassVar[dict[str, Field[Any]]]
    __match_args__ = ("tests", "run_all", "reason")
    def __init__(self, tests: tuple[str, ...], run_all: bool, reason: str) -> None: ...
    @property
    def tests(self) -> tuple[str, ...]: ...
    @property
    def run_all(self) -> bool: ...
    @property
    def reason(self) -> str: ...
    def __hash__(self) -> int: ...

class _Selector(Protocol):
    def select(self, patch: Patch, repo: Path) -> Selection: ...

RUN_ALL: Selection

def register_selector(selector_id: str, selector: _Selector) -> None: ...
def get_selector(selector_id: str) -> _Selector: ...
def choose(
    tests: tuple[str, ...] | None, selector_id: str | None, patch: Patch, repo: Path
) -> Selection: ...
def restrict_to_tree(selection: Selection, tree: Path) -> Selection | None: ...
