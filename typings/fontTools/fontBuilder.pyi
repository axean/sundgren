from collections.abc import Mapping

from fontTools.pens.ttGlyphPen import Glyph

class TTFont:
    flavor: str | None
    recalcTimestamp: bool

class FontBuilder:
    font: TTFont
    def __init__(self, unitsPerEm: int | None = None, *, isTTF: bool = True) -> None: ...
    def updateHead(self, **values: int) -> None: ...
    def setupGlyphOrder(self, glyphOrder: list[str]) -> None: ...
    def setupCharacterMap(self, cmapping: Mapping[int, str]) -> None: ...
    def setupGlyf(self, glyphs: Mapping[str, Glyph]) -> None: ...
    def setupHorizontalMetrics(self, metrics: Mapping[str, tuple[int, int]]) -> None: ...
    def setupHorizontalHeader(self, **values: int) -> None: ...
    def setupNameTable(self, nameStrings: Mapping[str, str]) -> None: ...
    def setupOS2(self, **values: int) -> None: ...
    def setupPost(self) -> None: ...
    def save(self, file: str) -> None: ...
